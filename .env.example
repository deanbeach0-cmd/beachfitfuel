# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID_MARSHALL=L5SZFKEJNPFT5
SQUARE_LOCATION_ID_BATTLE_CREEK=LXN2M7AEC7787
SYNC_SECRET=pick-any-long-random-string
# Gates /admin (category mapping + visibility) — pick any long random password
ADMIN_PASSWORD=pick-any-long-random-string
# Square Web Payments (find in developer.squareup.com → your app → Credentials)
# Shared by both the apparel checkout and the drink pickup checkout (both
# locations) — only affects which payment methods are offered client-side,
# doesn't lock the card token to a location. The server picks the real
# settlement location via SQUARE_LOCATION_ID_MARSHALL/BATTLE_CREEK above.
NEXT_PUBLIC_SQUARE_APP_ID=sq0idp-your-app-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-location-id

# Printful — generate at printful.com → Dashboard → Settings → API
# Your API key is already scoped to your store — no shop ID needed
PRINTFUL_API_KEY=your-printful-api-key

# Resend
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=hello@beachfitfuel.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
